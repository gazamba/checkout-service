# ----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
#   cp .env.example .env.local
# `.env.local` is git-ignored; this `.env.example` is committed as documentation.
# ----------------------------------------------------------------------------

# --- Database (Neon Postgres) -----------------------------------------------
# Connection string from your Neon project dashboard.
# Use the POOLED connection string (host contains "-pooler") so the serverless
# driver works well in a distributed/serverless environment.
# Format: postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Better Auth ------------------------------------------------------------
# Secret used to sign/encrypt sessions and tokens. MUST be a long random string.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# Base URL where the app is reachable. Used for auth callbacks and cookies.
# Local dev: http://localhost:3000   Production: https://your-domain.com
BETTER_AUTH_URL="http://localhost:3000"

# --- GitHub OAuth -----------------------------------------------------------
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL must be:
#   <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID="your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-client-secret"
